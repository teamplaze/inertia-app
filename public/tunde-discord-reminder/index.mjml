<mjml>
  <mj-head>
    <mj-title>Babatunde heads into the studio Friday — are you in?</mj-title>

    <mj-font name="Albert Sans" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@300;400;500;600;700&display=swap" />

    <mj-attributes>
      <mj-all font-family="'Albert Sans', Arial, sans-serif" />
      <mj-text
        font-family="'Albert Sans', Arial, sans-serif"
        font-size="16px"
        line-height="1.6"
        color="#ededed"
      />
      <mj-section background-color="#000000" padding="0" />
    </mj-attributes>

    <mj-style inline="inline">
      .footer-link { color: #3e958e !important; text-decoration: none; }
      .teal { color: #3e958e; }
    </mj-style>

    <mj-style>
      .logo-light { display: block !important; }
      .logo-dark  { display: none  !important; max-height: 0 !important; overflow: hidden; }

      @media (prefers-color-scheme: dark) {
        .logo-light { display: none  !important; max-height: 0 !important; overflow: hidden; }
        .logo-dark  { display: block !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#000000">

    <!-- PRE-HEADER -->
    <mj-section padding="0">
      <mj-column>
        <mj-text font-size="1px" color="#000000" padding="0" line-height="1">
          Babatunde hits the studio Friday at 2pm — here's what you're getting access to.&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌&nbsp;‌
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HEADER -->
    <mj-section background-color="#000000" padding="32px 40px 24px" border-bottom="1px solid #3f4948">
      <mj-column vertical-align="middle">
        <mj-image css-class="logo-light" src="https://oxnvcrwrhswpgqfmrhzo.supabase.co/storage/v1/object/public/inertia-logo/Inertia-teal.png" alt="Inertia" width="140px" align="left" href="https://theinertiaproject.com/" padding="0" />
        <mj-image css-class="logo-dark" src="https://oxnvcrwrhswpgqfmrhzo.supabase.co/storage/v1/object/public/inertia-logo/inertia-white.png" alt="Inertia" width="140px" align="left" href="https://theinertiaproject.com/" padding="0" />
      </mj-column>
      <mj-column vertical-align="middle">
        <mj-text align="right" font-size="11px" font-weight="500" color="#888f8e" padding="0" letter-spacing="0.12em">
          <span style="text-transform: uppercase; letter-spacing: 0.12em;">Backer Update</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HERO -->
    <mj-section background-color="#000000" padding="48px 40px 32px">
      <mj-column>

        <mj-text font-size="11px" font-weight="600" color="#3e958e" padding="0 0 12px 0" letter-spacing="0.15em">
          <span style="text-transform: uppercase; letter-spacing: 0.15em;">✦ &nbsp;Studio Week</span>
        </mj-text>

        <mj-text font-size="40px" font-weight="600" line-height="1.15" color="#ffffff" padding="0 0 20px 0" letter-spacing="-0.01em">
          Babatunde hits<br />
          the studio<br />
          <span style="color: #3e958e;">Friday at 2pm.</span>
        </mj-text>

        <mj-text font-size="16px" font-weight="300" color="#c3c7c7" line-height="1.6" padding="0">
          Hey {firstName} — this is the moment your backing makes real. Babatunde goes into the studio Friday and as a backer, you're getting access to the whole thing — but only through Discord. Here's everything you're about to experience.
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ─────────────────────────────────────────────
         ACCESS & EXPERIENCE — dark card
    ───────────────────────────────────────────── -->
    <mj-section background-color="#000000" padding="0">
      <mj-column>
        <mj-text font-size="3px" line-height="1" color="#3e958e" padding="0">​</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#000000" padding="32px 40px 8px">
      <mj-column>
        <mj-text font-size="11px" font-weight="600" color="#888f8e" padding="0 0 20px 0" letter-spacing="0.12em">
          <span style="text-transform: uppercase; letter-spacing: 0.12em;">Access &amp; Experience</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Studio Updates & Livestreams -->
    <mj-section background-color="#000000" padding="0 40px">
      <mj-column>
        <mj-text font-size="15px" font-weight="500" color="#ffffff" padding="0 0 4px 0" line-height="1.4">Studio Updates</mj-text>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.6" padding="0 0 20px 0">
          Short videos and photos shared directly in Discord from inside the studio — the kind of content that never makes it to social.
        </mj-text>
        <mj-divider border-color="#3f4948" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Livestreams -->
    <mj-section background-color="#000000" padding="0 40px">
      <mj-column>
        <mj-text font-size="15px" font-weight="500" color="#ffffff" padding="14px 0 4px 0" line-height="1.4">Livestreams</mj-text>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.6" padding="0 0 20px 0">
          Tunde's experiencing a professional studio for the first time, join him there with live Q&amp;A so you can be part of the conversation.
        </mj-text>
        <mj-divider border-color="#3f4948" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Studio tour and live recording -->
    <mj-section background-color="#000000" padding="0 40px">
      <mj-column>
        <mj-text font-size="15px" font-weight="500" color="#ffffff" padding="14px 0 4px 0" line-height="1.4">Studio Tour &amp; Live Recording Clips</mj-text>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.6" padding="0 0 20px 0">
          Go inside the recording process — takes, mistakes, and the real unfiltered experience of making music. No highlight reel, just the authentic thing.
        </mj-text>
        <mj-divider border-color="#3f4948" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Listen back sessions -->
    <mj-section background-color="#000000" padding="0 40px 32px">
      <mj-column>
        <mj-text font-size="15px" font-weight="500" color="#ffffff" padding="14px 0 4px 0" line-height="1.4">Listen Back Sessions</mj-text>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.6" padding="0">
          After recording, listen to the raw tracks alongside Babatunde and watch his genuine first reaction to the music — unedited, unpolished, real.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#3f4948" padding="0">
      <mj-column>
        <mj-text font-size="1px" line-height="1" color="#3f4948" padding="0">​</mj-text>
      </mj-column>
    </mj-section>


    <!-- ─────────────────────────────────────────────
         JOIN DISCORD CTA — dark card
    ───────────────────────────────────────────── -->
    <mj-section background-color="#3e958e" padding="0">
      <mj-column>
        <mj-text font-size="3px" line-height="1" color="#3e958e" padding="0">​</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#000000" padding="32px 40px 8px">
      <mj-column>
        <mj-text font-size="11px" font-weight="600" color="#888f8e" padding="0 0 16px 0" letter-spacing="0.12em">
          <span style="text-transform: uppercase; letter-spacing: 0.12em;">To Access All of This</span>
        </mj-text>
        <mj-text font-size="22px" font-weight="600" color="#ffffff" padding="0 0 12px 0" line-height="1.2">
          You need to be in the Discord.
        </mj-text>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.65" padding="0 0 24px 0">
          Everything above happens exclusively in Babatunde's Discord server. If you haven't joined yet, now is the time — studio week starts Friday.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Notification callout -->
    <mj-section background-color="#000000" padding="0 40px 24px">
      <mj-column border-left="2px solid #3e958e" padding-left="20px">
        <mj-text font-size="14px" font-weight="500" color="#ffffff" padding="0 0 8px 0" line-height="1.4">
          Turn on notifications once you're in
        </mj-text>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.65" padding="0 0 12px 0">
          Live streams and studio drops happen with zero warning. Don't find out a day later.
        </mj-text>
        <mj-text font-size="13px" font-weight="400" color="#888f8e" line-height="1.65" padding="0">
          Click the server name → right-click (or tap-and-hold on mobile) → Notification Settings → All Messages
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Discord button -->
    <mj-section background-color="#000000" padding="0 40px 32px">
      <mj-column>
        <mj-button
          href="https://discord.gg/GhBSqWkPA"
          background-color="#ffffff"
          color="#000000"
          font-size="15px"
          font-weight="600"
          font-family="'Albert Sans', Arial, sans-serif"
          letter-spacing="0.02em"
          border-radius="0"
          inner-padding="14px 28px"
          padding="0"
          align="left"
        >
          Join the Discord →
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#3f4948" padding="0">
      <mj-column>
        <mj-text font-size="1px" line-height="1" color="#3f4948" padding="0">​</mj-text>
      </mj-column>
    </mj-section>

    <!-- Discord help -->
    <mj-section background-color="#000000" padding="16px 40px 48px">
      <mj-column>
        <mj-text font-size="13px" color="#888f8e" padding="0" line-height="1.5">
          New to Discord? <a href="https://support.discord.com/hc/en-us/articles/360033931551" style="color: #3e958e; text-decoration: none;">Here's how to get started →</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- SIGN-OFF -->
    <mj-section background-color="#000000" border-top="1px solid #3f4948" padding="0 40px 48px">
      <mj-column>
        <mj-text font-size="14px" font-weight="300" color="#c3c7c7" line-height="1.6" padding="24px 0 0 0">
          See you in there Friday.<br />
          <span style="color: #ffffff; font-weight: 500;">— The Inertia Team</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- QUESTIONS -->
    <mj-section background-color="#000000" padding="0 40px 48px">
      <mj-column>
        <mj-text font-size="13px" color="#888f8e" padding="0" line-height="1.5">
          Questions? <a href="mailto:team@theinertiaproject.com" style="color: #3e958e; text-decoration: none;">team@theinertiaproject.com</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section background-color="#000000" border-top="1px solid #3f4948" padding="32px 40px 40px">
      <mj-column>

        <mj-image css-class="logo-light" src="https://oxnvcrwrhswpgqfmrhzo.supabase.co/storage/v1/object/public/inertia-logo/Inertia-teal.png" alt="Inertia" width="100px" align="left" href="https://theinertiaproject.com/" padding="0 0 24px" />
        <mj-image css-class="logo-dark" src="https://oxnvcrwrhswpgqfmrhzo.supabase.co/storage/v1/object/public/inertia-logo/inertia-white.png" alt="Inertia" width="100px" align="left" href="https://theinertiaproject.com/" padding="0 0 24px" />

        <mj-text font-size="12px" color="#888f8e" line-height="1.6" padding="0 0 16px">
          You're receiving this because you backed a project on The Inertia Project platform.
        </mj-text>

        <mj-text font-size="12px" color="#888f8e" padding="0 0 8px">
          © 2026 The Inertia Project. All rights reserved.
        </mj-text>

        <mj-text font-size="12px" padding="0">
          <a href="https://theinertiaproject.com/" style="color: #3e958e; text-decoration: none;">Visit Inertia</a>
          &nbsp;&nbsp;·&nbsp;&nbsp;
          <a href="https://theinertiaproject.com/account" style="color: #3e958e; text-decoration: none;">My Account</a>
          &nbsp;&nbsp;·&nbsp;&nbsp;
          <a href="mailto:team@theinertiaproject.com" style="color: #3e958e; text-decoration: none;">Contact Us</a>
          &nbsp;&nbsp;·&nbsp;&nbsp;
          <a href="{unsubscribe_link}" style="color: #888f8e; text-decoration: none;">Unsubscribe</a>
        </mj-text>

      </mj:column>
    </mj-section>

  </mj-body>
</mjml>
